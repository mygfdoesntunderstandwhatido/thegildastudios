{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/branch/**",
              "components/brand/**",
              "components/content/**",
              "components/core/**",
              "components/layout/**",
              "components/social/**",
              "dev/**",
              "ui_kits/print/**",
              "ui_kits/social/**",
              "ui_kits/website/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Gilda Display|Archivo|IBM Plex Mono))/i]",
        "message": "Font not provided by the design system. Available: Gilda Display, Archivo, IBM Plex Mono."
      },
      {
        "selector": "JSXOpeningElement[name.name='AppIcon'] > JSXAttribute > JSXIdentifier[name!=/^(?:size|shadow|style|key|ref|className|style|children)$/]",
        "message": "<AppIcon> doesn't accept that prop. Declared props: size, shadow, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='BranchCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:branch|title|description|illustrationHeight|style|key|ref|className|style|children)$/]",
        "message": "<BranchCard> doesn't accept that prop. Declared props: branch, title, description, illustrationHeight, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='BranchCard'] > JSXAttribute[name.name='branch'] > Literal[value!=/^(?:plan|build|grow)$/]",
        "message": "<BranchCard> branch must be one of 'plan' | 'build' | 'grow'."
      },
      {
        "selector": "JSXOpeningElement[name.name='BranchDot'] > JSXAttribute > JSXIdentifier[name!=/^(?:branch|onDark|size|style|key|ref|className|style|children)$/]",
        "message": "<BranchDot> doesn't accept that prop. Declared props: branch, onDark, size, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='BranchDot'] > JSXAttribute[name.name='branch'] > Literal[value!=/^(?:plan|build|grow)$/]",
        "message": "<BranchDot> branch must be one of 'plan' | 'build' | 'grow'."
      },
      {
        "selector": "JSXOpeningElement[name.name='BranchDots'] > JSXAttribute > JSXIdentifier[name!=/^(?:onDark|size|gap|style|key|ref|className|style|children)$/]",
        "message": "<BranchDots> doesn't accept that prop. Declared props: onDark, size, gap, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='BranchTag'] > JSXAttribute > JSXIdentifier[name!=/^(?:branch|format|onDark|size|children|style|key|ref|className|style|children)$/]",
        "message": "<BranchTag> doesn't accept that prop. Declared props: branch, format, onDark, size, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='BranchTag'] > JSXAttribute[name.name='branch'] > Literal[value!=/^(?:plan|build|grow)$/]",
        "message": "<BranchTag> branch must be one of 'plan' | 'build' | 'grow'."
      },
      {
        "selector": "JSXOpeningElement[name.name='BranchTag'] > JSXAttribute[name.name='format'] > Literal[value!=/^(?:name|ingredient)$/]",
        "message": "<BranchTag> format must be one of 'name' | 'ingredient'."
      },
      {
        "selector": "JSXOpeningElement[name.name='BranchTag'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md|social)$/]",
        "message": "<BranchTag> size must be one of 'sm' | 'md' | 'social'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|size|caps|href|onClick|disabled|children|style|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: variant, size, caps, href, onClick, disabled, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:primary|dark|light|outline|outline-light)$/]",
        "message": "<Button> variant must be one of 'primary' | 'dark' | 'light' | 'outline' | 'outline-light'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md|lg)$/]",
        "message": "<Button> size must be one of 'sm' | 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Chip'] > JSXAttribute > JSXIdentifier[name!=/^(?:onDark|children|style|key|ref|className|style|children)$/]",
        "message": "<Chip> doesn't accept that prop. Declared props: onDark, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='CreditLine'] > JSXAttribute > JSXIdentifier[name!=/^(?:verb|mark|color|size|style|key|ref|className|style|children)$/]",
        "message": "<CreditLine> doesn't accept that prop. Declared props: verb, mark, color, size, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='CreditLine'] > JSXAttribute[name.name='verb'] > Literal[value!=/^(?:Built by|Made by|Produced by)$/]",
        "message": "<CreditLine> verb must be one of 'Built by' | 'Made by' | 'Produced by'."
      },
      {
        "selector": "JSXOpeningElement[name.name='CreditLine'] > JSXAttribute[name.name='mark'] > Literal[value!=/^(?:none|engraved|outline)$/]",
        "message": "<CreditLine> mark must be one of 'none' | 'engraved' | 'outline'."
      },
      {
        "selector": "JSXOpeningElement[name.name='DoDont'] > JSXAttribute > JSXIdentifier[name!=/^(?:insteadOf|weSay|style|key|ref|className|style|children)$/]",
        "message": "<DoDont> doesn't accept that prop. Declared props: insteadOf, weSay, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Label'] > JSXAttribute > JSXIdentifier[name!=/^(?:tone|size|tracking|as|children|style|key|ref|className|style|children)$/]",
        "message": "<Label> doesn't accept that prop. Declared props: tone, size, tracking, as, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Label'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md|social)$/]",
        "message": "<Label> size must be one of 'sm' | 'md' | 'social'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Label'] > JSXAttribute[name.name='tracking'] > Literal[value!=/^(?:label|running)$/]",
        "message": "<Label> tracking must be one of 'label' | 'running'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Lockup'] > JSXAttribute > JSXIdentifier[name!=/^(?:layout|size|mark|color|style|key|ref|className|style|children)$/]",
        "message": "<Lockup> doesn't accept that prop. Declared props: layout, size, mark, color, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Lockup'] > JSXAttribute[name.name='layout'] > Literal[value!=/^(?:stacked|horizontal)$/]",
        "message": "<Lockup> layout must be one of 'stacked' | 'horizontal'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Lockup'] > JSXAttribute[name.name='mark'] > Literal[value!=/^(?:full|engraved|outline)$/]",
        "message": "<Lockup> mark must be one of 'full' | 'engraved' | 'outline'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Mark'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|height|color|style|key|ref|className|style|children)$/]",
        "message": "<Mark> doesn't accept that prop. Declared props: variant, height, color, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Mark'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:full|engraved|outline)$/]",
        "message": "<Mark> variant must be one of 'full' | 'engraved' | 'outline'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Monogram'] > JSXAttribute > JSXIdentifier[name!=/^(?:size|variant|color|style|key|ref|className|style|children)$/]",
        "message": "<Monogram> doesn't accept that prop. Declared props: size, variant, color, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Monogram'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:tile|outline)$/]",
        "message": "<Monogram> variant must be one of 'tile' | 'outline'."
      },
      {
        "selector": "JSXOpeningElement[name.name='PhotoPlaceholder'] > JSXAttribute > JSXIdentifier[name!=/^(?:format|src|style|key|ref|className|style|children)$/]",
        "message": "<PhotoPlaceholder> doesn't accept that prop. Declared props: format, src, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='PhotoPlaceholder'] > JSXAttribute[name.name='format'] > Literal[value!=/^(?:feed|square|story|full-story)$/]",
        "message": "<PhotoPlaceholder> format must be one of 'feed' | 'square' | 'story' | 'full-story'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Post'] > JSXAttribute > JSXIdentifier[name!=/^(?:format|ground|padding|bleed|children|style|key|ref|className|style|children)$/]",
        "message": "<Post> doesn't accept that prop. Declared props: format, ground, padding, bleed, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Post'] > JSXAttribute[name.name='format'] > Literal[value!=/^(?:feed|square|story)$/]",
        "message": "<Post> format must be one of 'feed' | 'square' | 'story'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Post'] > JSXAttribute[name.name='ground'] > Literal[value!=/^(?:cream|sand|pepper-pale|pepper|salt|olive|olive-deep|anchovy|cure|brine)$/]",
        "message": "<Post> ground must be one of 'cream' | 'sand' | 'pepper-pale' | 'pepper' | 'salt' | 'olive' | 'olive-deep' | 'anchovy' | 'cure' | 'brine'."
      },
      {
        "selector": "JSXOpeningElement[name.name='PostMeta'] > JSXAttribute > JSXIdentifier[name!=/^(?:left|right|style|key|ref|className|style|children)$/]",
        "message": "<PostMeta> doesn't accept that prop. Declared props: left, right, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Quote'] > JSXAttribute > JSXIdentifier[name!=/^(?:quote|name|business|ground|scale|style|key|ref|className|style|children)$/]",
        "message": "<Quote> doesn't accept that prop. Declared props: quote, name, business, ground, scale, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Quote'] > JSXAttribute[name.name='ground'] > Literal[value!=/^(?:cream|sand|pepper-pale|pepper|salt|olive|olive-deep|anchovy|cure|brine)$/]",
        "message": "<Quote> ground must be one of 'cream' | 'sand' | 'pepper-pale' | 'pepper' | 'salt' | 'olive' | 'olive-deep' | 'anchovy' | 'cure' | 'brine'."
      },
      {
        "selector": "JSXOpeningElement[name.name='RuleColumn'] > JSXAttribute > JSXIdentifier[name!=/^(?:kicker|title|children|note|weight|onDark|titleSize|ruleColor|style|key|ref|className|style|children)$/]",
        "message": "<RuleColumn> doesn't accept that prop. Declared props: kicker, title, children, note, weight, onDark, titleSize, ruleColor, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='RuleColumn'] > JSXAttribute[name.name='weight'] > Literal[value!=/^(?:strong|light)$/]",
        "message": "<RuleColumn> weight must be one of 'strong' | 'light'."
      },
      {
        "selector": "JSXOpeningElement[name.name='RunningHeader'] > JSXAttribute > JSXIdentifier[name!=/^(?:number|left|right|onDark|style|key|ref|className|style|children)$/]",
        "message": "<RunningHeader> doesn't accept that prop. Declared props: number, left, right, onDark, style."
