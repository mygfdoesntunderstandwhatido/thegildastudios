        "selector": "JSXOpeningElement[name.name='SpecRow'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|children|note|first|last|size|style|key|ref|className|style|children)$/]",
        "message": "<SpecRow> doesn't accept that prop. Declared props: label, children, note, first, last, size, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Swatch'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|hex|note|dark|ring|height|style|key|ref|className|style|children)$/]",
        "message": "<Swatch> doesn't accept that prop. Declared props: name, hex, note, dark, ring, height, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Wordmark'] > JSXAttribute > JSXIdentifier[name!=/^(?:layout|size|color|style|key|ref|className|style|children)$/]",
        "message": "<Wordmark> doesn't accept that prop. Declared props: layout, size, color, style."
