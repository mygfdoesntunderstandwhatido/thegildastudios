        "selector": "JSXOpeningElement[name.name='Wordmark'] > JSXAttribute[name.name='layout'] > Literal[value!=/^(?:stacked|line)$/]",
        "message": "<Wordmark> layout must be one of 'stacked' | 'line'."
      }
    ]
  },
