---
import type { HTMLAttributes } from 'astro/types';
import { getSettings } from '../../lib/settings';

interface Props extends Omit<HTMLAttributes<'span'>, 'role' | 'style'> {
  /** Tile size in px. The monogram stands in for the mark below 48px. */
  size?: number;
  /** tile = Cream tile, dark = Brine tile, outline = a ring in the current colour. */
  variant?: 'tile' | 'dark' | 'outline';
  /** Accessible name. Pass an empty string when the monogram is decorative. */
  alt?: string;
  /** Ring and letter colour of the outline variant. Defaults to the current colour. */
  fill?: string;
}

const { brand } = await getSettings();
const {
  size = 48,
  variant = 'tile',
  alt = brand.markLabel,
  fill,
  class: className,
  ...attrs
} = Astro.props;
const decorative = alt === '';
---

<span
  {...attrs}
  role={decorative ? undefined : 'img'}
  aria-label={decorative ? undefined : alt}
  aria-hidden={decorative ? 'true' : undefined}
  class:list={['monogram', className]}
  data-variant={variant}
  style={`--monogram-size: ${size}px${fill ? `; color: ${fill}` : ''}`}
>
  {brand.monogram}
</span>

<style>
  .monogram {
    --monogram-ring: max(1.5px, calc(var(--monogram-size) / 38));

    display: inline-flex;
    flex: none;
    align-items: center;
    justify-content: center;
    inline-size: var(--monogram-size);
    block-size: var(--monogram-size);
    border-radius: var(--radius-icon);
    background: var(--cream);
    color: var(--brine);
    font-family: var(--font-display);
    font-size: calc(var(--monogram-size) * 0.48);
    font-weight: var(--weight-regular);
    line-height: 1;
    letter-spacing: -0.02em;
  }

  .monogram[data-variant='dark'] {
    background: var(--brine);
    color: var(--cream);
  }

  .monogram[data-variant='outline'] {
    background: transparent;
    box-shadow: inset 0 0 0 var(--monogram-ring) currentcolor;
    color: inherit;
  }
</style>
