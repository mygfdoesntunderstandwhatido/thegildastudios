---
import type { HTMLAttributes } from 'astro/types';
import { testimonialLabels } from '../../content/ui/testimonial';

interface Props extends Omit<HTMLAttributes<'figure'>, 'role'> {
  quote: string;
  name: string;
  role?: string;
  business?: string;
  caseStudy: { slug: string };
  markColor?: 'olive' | 'anchovy' | 'pepper';
  variant?: 'dark' | 'light';
}

const {
  quote,
  name,
  role,
  business,
  caseStudy,
  markColor = 'olive',
  variant = 'dark',
  class: className,
  ...attrs
} = Astro.props;
const href = `/projects/${encodeURIComponent(caseStudy.slug)}/`;
---

<figure
  {...attrs}
  aria-label={attrs['aria-label'] ?? testimonialLabels.figureLabel}
  class:list={['testimonial', className]}
  data-variant={variant}
  data-mark={markColor}
>
  <span class="quote-mark" aria-hidden="true">
    {testimonialLabels.mark}
  </span>
  <blockquote class="quote-body" cite={href}>
    <p>{quote}</p>
  </blockquote>
  <figcaption class="attribution">
    <span class="quote-name">{name}</span>
    {(role || business) && <span class="quote-role">{role || business}</span>}
    <a class="project-link" href={href}>
      {testimonialLabels.projectLink}
    </a>
  </figcaption>
</figure>

<style>
  .testimonial {
    --quote-size: 36px;
    --quote-leading: 1.3;
    --quote-mark-size: 200px;
    --quote-mark-leading: 0.5;
    --quote-measure: 960px;
    --quote-gap: var(--space-9);
    --quote-name-size: var(--display-26);
    --quote-caption-leading: 1.1;
    --quote-role-size: 12px;
    --quote-role-leading: 1;
    --quote-role-color: var(--cream-2);
    --quote-foreground: var(--cream);
    --quote-mark-color: var(--olive-on-dark);
    --quote-link-color: var(--pepper-pale);
    --quote-link-gap: 6px;
    --quote-link-padding: 10px;
    --quote-link-rule: 1px;

    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--quote-gap);
    color: var(--quote-foreground);
    text-align: center;
  }

  .quote-mark {
    margin-block-start: var(--space-10);
    color: var(--quote-mark-color);
    font-family: var(--font-display);
    font-size: var(--quote-mark-size);
    line-height: var(--quote-mark-leading);
  }

  .quote-body {
    max-inline-size: var(--quote-measure);
    font-family: var(--font-display);
    font-size: var(--quote-size);
    line-height: var(--quote-leading);
    text-wrap: pretty;
  }

  .attribution {
    display: flex;
    flex-direction: column;
    align-items: inherit;
    gap: var(--quote-link-padding);
  }

  .quote-name {
    font-family: var(--font-display);
    font-size: var(--quote-name-size);
    line-height: var(--quote-caption-leading);
  }

  .quote-role {
    color: var(--quote-role-color);
    font: var(--type-label);
    font-size: var(--quote-role-size);
    line-height: var(--quote-role-leading);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
  }

  .project-link,
  .project-link:hover {
    align-self: center;
    margin-block-start: var(--quote-link-gap);
    padding-block: var(--quote-link-padding);
    box-shadow: inset 0 calc(var(--quote-link-rule) * -1) 0 var(--quote-link-color);
    color: var(--quote-link-color);
    font: var(--type-label-sm);
    letter-spacing: var(--tracking-label);
    text-decoration: none;
  }

  .testimonial[data-variant='dark'][data-mark='anchovy'] {
    --quote-mark-color: var(--anchovy-on-dark);
  }

  .testimonial[data-variant='dark'][data-mark='pepper'] {
    --quote-mark-color: var(--pepper);
  }

  .testimonial[data-variant='light'] {
    --quote-size: 24px;
    --quote-leading: 1.35;
    --quote-mark-size: 96px;
    --quote-name-size: 20px;
    --quote-role-size: 11px;
    --quote-role-leading: 1.4;
    --quote-role-color: var(--ink-3);
    --quote-foreground: var(--brine);
    --quote-mark-color: var(--olive);
    --quote-link-color: var(--olive);
    --quote-gap: var(--space-4);

    align-items: flex-start;
    padding-block: var(--space-6) var(--space-7);
    border-block-start: var(--border-rule-strong);
    text-align: start;
  }

  .testimonial[data-variant='light'] .quote-mark {
    margin-block-start: var(--space-7);
  }

  .testimonial[data-variant='light'] .attribution {
    gap: var(--quote-link-gap);
  }

  .testimonial[data-variant='light'] .project-link {
    align-self: flex-start;
  }

  @media (width < 768px) {
    .testimonial {
      --quote-size: var(--display-22);
      --quote-leading: 1.35;
      --quote-mark-size: 110px;
      --quote-name-size: 21px;
      --quote-role-size: 10px;
      --quote-gap: var(--space-6);

      align-items: flex-start;
      text-align: start;
    }

    .quote-mark {
      margin-block-start: var(--space-7);
    }

    .attribution {
      gap: var(--space-2);
    }

    .project-link {
      align-self: flex-start;
    }

    .testimonial[data-variant='light'] {
      --quote-size: 19px;
      --quote-leading: 1.4;
      --quote-mark-size: 72px;
      --quote-name-size: 18px;
      --quote-role-size: 10px;
      --quote-gap: var(--space-3);
      --quote-phone-pad: 18px;
      --quote-phone-pad-end: 22px;

      padding-block: var(--quote-phone-pad) var(--quote-phone-pad-end);
    }

    .testimonial[data-variant='light'] .quote-mark {
      margin-block-start: var(--quote-phone-pad-end);
    }
  }
</style>
