---
import { getEntry, type CollectionEntry } from 'astro:content';
import { BRANCH_BY_COLOR, branches } from '../../lib/branches';
import { typography } from '../../lib/typography';
import Testimonial from './Testimonial.astro';

interface Props {
  testimonials: CollectionEntry<'testimonials'>[];
  id?: string;
  number?: string;
}

const home = await getEntry('homepage', 'home');
if (!home) throw new Error('Missing the homepage singleton: src/content/homepage/home.json');
const copy = home.data.testimonials;
const { testimonials, id = 'in-their-words', number = copy.number } = Astro.props;
const total = testimonials.length;
const pad = (value: number) => String(value).padStart(2, '0');
const counter = (index: number) => `${pad(index + 1)} / ${pad(total)}`;
const titleId = `${id}-title`;
const slides = testimonials.map(({ data }, index) => ({
  ...data,
  label: copy.slideLabel
    .replace('{index}', String(index + 1))
    .replace('{total}', String(total))
    .replace('{name}', data.name),
  dotColor: branches[BRANCH_BY_COLOR[data.markColor]].onDark,
}));
---

<section
  id={id}
  class="band band--brine band--spacious rotator-band"
  role="region"
  aria-roledescription={copy.roleDescription}
  aria-labelledby={titleId}
>
  <gilda-testimonial-rotator class="container rotator">
    <h2 class="counter">
      <span aria-hidden="true">
        {number} {typography.dot}{' '}
      </span>
      <span id={titleId}>{copy.title}</span>
      <span class="counter-position" aria-hidden="true">
        {` ${typography.dot} `}
        <span data-counter>{counter(0)}</span>
      </span>
    </h2>
    <div class="stage">
      <button
        class="step"
        type="button"
        aria-label={copy.previousLabel}
        data-step="-1"
        hidden={total < 2}
      >
        <svg viewBox="0 0 20 20" aria-hidden="true" focusable="false">
          <path d="M12 4 6 10l6 6" />
        </svg>
      </button>
      <div class="slides">
        {slides.map((slide, index) => (
          <div
            class="slide"
            data-slide
            data-counter-text={counter(index)}
            data-active={index === 0 ? '' : undefined}
          >
            <Testimonial
              quote={slide.quote}
              name={slide.name}
              role={slide.role}
              caseStudy={{ slug: slide.caseStudy }}
              markColor={slide.markColor}
              aria-roledescription={copy.slideRoleDescription}
              aria-label={slide.label}
            />
          </div>
        ))}
      </div>
      <button
        class="step"
        type="button"
        aria-label={copy.nextLabel}
        data-step="1"
        hidden={total < 2}
      >
        <svg viewBox="0 0 20 20" aria-hidden="true" focusable="false">
          <path d="m8 4 6 6-6 6" />
        </svg>
      </button>
    </div>
    <div class="controls">
      <div class="dots" role="group" aria-label={copy.controlsLabel}>
        <span class="skewer" aria-hidden="true"></span>
        {slides.map((slide, index) => (
          <button
            class="dot"
            type="button"
            aria-label={slide.label}
            aria-current={index === 0 ? 'true' : undefined}
            data-dot
            style={`--dot-color: ${slide.dotColor}`}
          >
            <span class="dot-mark"></span>
          </button>
        ))}
      </div>
    </div>
    <p class="visually-hidden" aria-live="polite" aria-atomic="true" data-status></p>
  </gilda-testimonial-rotator>
</section>

<script>
  class GildaTestimonialRotator extends HTMLElement {
    private slides: HTMLElement[] = [];
    private dots: HTMLButtonElement[] = [];
    private index = 0;
    private gesture: { id: number; x: number; y: number } | null = null;
    private swiped = false;
    private events?: AbortController;
    private animations: Animation[] = [];
    private reducedMotion = matchMedia('(prefers-reduced-motion: reduce)');

    connectedCallback() {
      this.events?.abort();
      this.events = new AbortController();
      const { signal } = this.events;
      this.slides = [...this.querySelectorAll<HTMLElement>('[data-slide]')];
      this.dots = [...this.querySelectorAll<HTMLButtonElement>('[data-dot]')];
      this.dots.forEach((dot, index) => {
        dot.addEventListener('click', () => this.show(index, true, Math.sign(index - this.index)), {
          signal,
        });
      });
      this.querySelectorAll<HTMLButtonElement>('[data-step]').forEach((button) => {
        const step = Number(button.dataset.step);
        button.addEventListener('click', () => this.show(this.index + step, true, step), {
          signal,
        });
      });
      const slides = this.querySelector<HTMLElement>('.slides');
      slides?.addEventListener('pointerdown', this.onPointerDown, { signal });
      slides?.addEventListener('pointerup', this.onPointerUp, { signal });
      slides?.addEventListener('pointercancel', this.onPointerCancel, { signal });
      // A swipe that starts on the project link must not follow it on release.
      slides?.addEventListener('click', this.onClick, { capture: true, signal });
      this.show(this.index, false);
    }

    disconnectedCallback() {
      this.events?.abort();
      this.gesture = null;
      this.stopAnimations();
    }

    /** direction is 1 for the next quote, -1 for the previous, 0 for no movement. */
    private show(index: number, announce: boolean, direction = 0) {
      if (!this.slides.length) return;
      const box = this.querySelector<HTMLElement>('.slides');
      // Measured before stopping, so a quick second click starts from where the first got to.
      const from = box?.offsetHeight ?? 0;
      this.stopAnimations();
      const previous = this.slides[this.index];
      this.index = (index + this.slides.length) % this.slides.length;
      const next = this.slides[this.index];
      this.slides.forEach((slide, slideIndex) => {
        const active = slideIndex === this.index;
        slide.toggleAttribute('data-active', active);
        slide.inert = !active;
      });
      if (direction && box && previous && next && previous !== next && !this.reducedMotion.matches)
        this.slide(previous, next, box, from, direction);
      this.dots.forEach((dot, dotIndex) => {
        if (dotIndex === this.index) dot.setAttribute('aria-current', 'true');
        else dot.removeAttribute('aria-current');
      });
      const counter = this.querySelector('[data-counter]');
      if (counter) counter.textContent = this.slides[this.index]?.dataset.counterText ?? '';
      const status = this.querySelector('[data-status]');
      if (announce && status)
        status.textContent = this.dots[this.index]?.getAttribute('aria-label') ?? '';
    }

    // The old quote slips out towards one side while the new one slides in from
    // the other. The section eases gently between the two heights and clips the
    // quotes meanwhile, so neither spills over the dots as it grows or shrinks.
    private slide(
      previous: HTMLElement,
      next: HTMLElement,
      box: HTMLElement,
      from: number,
      direction: number,
    ) {
      const distance = 32 * direction;
      previous.toggleAttribute('data-leaving', true);
      box.toggleAttribute('data-resizing', true);
      const to = box.offsetHeight;
      const leave = previous.animate(
        [
          { opacity: 1, transform: 'none' },
          { opacity: 0, transform: `translateX(${-distance}px)` },
        ],
        { duration: 220, easing: 'cubic-bezier(0.4, 0, 1, 1)', fill: 'forwards' },
      );
      leave.addEventListener('finish', () => {
        previous.removeAttribute('data-leaving');
        leave.cancel();
      });
      const enter = next.animate(
        [
          { opacity: 0, transform: `translateX(${distance}px)` },
          { opacity: 1, transform: 'none' },
        ],
        { duration: 560, delay: 160, easing: 'cubic-bezier(0.2, 0.8, 0.2, 1)', fill: 'backwards' },
      );
      // Slow at both ends, so the dots and the page below never jolt.
      const resize = box.animate([{ blockSize: `${from}px` }, { blockSize: `${to}px` }], {
        duration: 640,
        easing: 'cubic-bezier(0.45, 0, 0.2, 1)',
      });
      resize.addEventListener('finish', () => box.removeAttribute('data-resizing'));
      this.animations = [leave, enter, resize];
    }

    private stopAnimations() {
      this.animations.forEach((animation) => animation.cancel());
      this.animations = [];
      this.slides.forEach((slide) => slide.removeAttribute('data-leaving'));
      this.querySelector('.slides')?.removeAttribute('data-resizing');
    }

    private onPointerDown = (event: PointerEvent) => {
      this.swiped = false;
      if (!event.isPrimary) this.gesture = null;
      if (event.pointerType !== 'touch' || !event.isPrimary || this.slides.length < 2) return;
      this.gesture = { id: event.pointerId, x: event.clientX, y: event.clientY };
    };

    private onPointerUp = (event: PointerEvent) => {
      const gesture = this.gesture;
      this.gesture = null;
      if (!gesture || gesture.id !== event.pointerId) return;
      const dx = event.clientX - gesture.x;
      const dy = event.clientY - gesture.y;
      // Leave vertical scrolling, taps and small diagonal movements to the browser.
      if (Math.abs(dx) < 48 || Math.abs(dx) <= Math.abs(dy)) return;
      this.swiped = true;
      const step = dx < 0 ? 1 : -1;
      this.show(this.index + step, true, step);
    };

    private onPointerCancel = () => {
      this.gesture = null;
    };

    private onClick = (event: MouseEvent) => {
      if (!this.swiped || event.detail === 0) return;
      event.preventDefault();
      event.stopPropagation();
      this.swiped = false;
    };
  }

  if (!customElements.get('gilda-testimonial-rotator')) {
    customElements.define('gilda-testimonial-rotator', GildaTestimonialRotator);
  }
</script>

<style>
  .rotator {
    --rotator-gap: var(--space-9);
    --dot-size: 10px;
    --dot-size-active: 18px;
    --dot-target: var(--space-11);
    --dot-gap: 6px;
    --dot-duration: 150ms;
    --step-size: var(--space-11);

    /* Centred on the shortest quote's text (176px down, about 234px tall at
       1280), so the arrows sit beside the words and stay put between quotes. */
    --step-offset: 270px;

    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--rotator-gap);
    text-align: center;
  }

  .counter {
    color: var(--salt);
    font: var(--type-label);
    letter-spacing: var(--tracking-label);
  }

  /* Only the chosen quote contributes height; short quotes leave no empty slot. */
  .stage {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: start;
    gap: var(--space-6);
    inline-size: 100%;
  }

  /* The quote slides sideways inside its own column, never across the arrows
     or past the page edge. */
  .slides {
    position: relative;
    inline-size: 100%;
    overflow-x: clip;
    touch-action: pan-y pinch-zoom;
  }

  .slides[data-resizing] {
    overflow: clip;
  }

  .slide:not([data-active]) {
    display: none;
  }

  /* The outgoing quote stays on top while it fades, out of the flow so the
     section can ease to the new quote's height. */
  .slide[data-leaving] {
    position: absolute;
    inset-block-start: 0;
    inset-inline: 0;
    display: block;
  }

  /* Previous and next sit either side of the quote at a fixed height, so they
     stay put whatever the length of the quote. */
  .step {
    display: flex;
    align-items: center;
    justify-content: center;
    inline-size: var(--step-size);
    block-size: var(--step-size);
    margin-block-start: var(--step-offset);
    padding: 0;
    border: 0;
    border-radius: var(--radius-pill);
    background: none;
    box-shadow: inset 0 0 0 1.5px var(--cream);
    color: var(--cream);
    cursor: pointer;
    transition: opacity var(--hover-duration) ease;
  }

  .step:hover {
    opacity: var(--hover-opacity);
  }

  .step[hidden] {
    display: none;
  }

  .step svg {
    inline-size: var(--space-5);
    block-size: var(--space-5);
    fill: none;
    stroke: currentcolor;
    stroke-width: 1.5;
    stroke-linecap: square;
  }

  .dots {
    position: relative;
    display: flex;
    align-items: center;
    gap: var(--dot-gap);
  }

  .skewer {
    position: absolute;
    inset-inline: calc(var(--dot-target) / 2);
    inset-block-start: 50%;
    block-size: 1px;
    background: color-mix(in srgb, var(--cream) 30%, transparent);
  }

  .dot {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    inline-size: var(--dot-target);
    block-size: var(--dot-target);
    padding: 0;
    border: 0;
    background: none;
    cursor: pointer;
  }

  .dot-mark {
    inline-size: var(--dot-size);
    block-size: var(--dot-size);
    border-radius: 50%;
    background: var(--dot-color);
    transition:
      inline-size var(--dot-duration) ease,
      block-size var(--dot-duration) ease;
  }

  .dot[aria-current='true'] .dot-mark {
    inline-size: var(--dot-size-active);
    block-size: var(--dot-size-active);
  }

  .visually-hidden {
    position: absolute;
    inline-size: 1px;
    block-size: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  /* Without JavaScript, every quote is listed and the controls are hidden. */
  @media (scripting: none) {
    .slides {
      display: grid;
      gap: var(--space-14);
    }

    .slide:not([data-active]) {
      display: block;
    }

    .counter-position,
    .controls,
    .step {
      display: none;
    }
  }

  /* On a phone the quote keeps the full width and the arrows join the section
     label, where they don't move as quotes change length. */
  @media (width < 768px) {
    .rotator {
      --rotator-gap: var(--space-6);
      --dot-gap: 2px;

      display: grid;
      grid-template-columns: minmax(0, 1fr) auto auto;
      grid-template-areas:
        'counter previous next'
        'slides slides slides'
        'controls controls controls';
      align-items: center;
      gap: var(--rotator-gap) var(--space-2);
      text-align: start;
    }

    .counter {
      grid-area: counter;
      font-size: var(--label-phone-size);
    }

    .stage {
      display: contents;
    }

    .slides {
      grid-area: slides;
    }

    .step {
      margin-block-start: 0;
    }

    .step[data-step='-1'] {
      grid-area: previous;
    }

    .step[data-step='1'] {
      grid-area: next;
    }

    .controls {
      grid-area: controls;
      justify-self: start;
      margin-inline-start: -14px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .dot-mark,
    .step {
      transition: none;
    }
  }
</style>
