---
import { getEntry, type CollectionEntry } from 'astro:content';
import { BRANCH_BY_COLOR, branches } from '../../lib/branches';
import { typography } from '../../lib/typography';
import Testimonial from './Testimonial.astro';

interface Props {
  testimonials: CollectionEntry<'testimonials'>[];
  id?: string;
  number?: string;
}

const home = await getEntry('homepage', 'home');
if (!home) throw new Error('Missing the homepage singleton: src/content/homepage/home.json');
const copy = home.data.testimonials;
const { testimonials, id = 'in-their-words', number = copy.number } = Astro.props;
const total = testimonials.length;
const pad = (value: number) => String(value).padStart(2, '0');
const counter = (index: number) => `${pad(index + 1)} / ${pad(total)}`;
const titleId = `${id}-title`;
const slides = testimonials.map(({ data }, index) => ({
  ...data,
  label: copy.slideLabel
    .replace('{index}', String(index + 1))
    .replace('{total}', String(total))
    .replace('{name}', data.name),
  dotColor: branches[BRANCH_BY_COLOR[data.markColor]].onDark,
}));
---

<section
  id={id}
  class="band band--brine band--spacious rotator-band"
  role="region"
  aria-roledescription={copy.roleDescription}
  aria-labelledby={titleId}
>
  <gilda-testimonial-rotator class="container rotator">
    <h2 class="counter">
      <span aria-hidden="true">
        {number} {typography.dot}{' '}
      </span>
      <span id={titleId}>{copy.title}</span>
      <span class="counter-position" aria-hidden="true">
        {` ${typography.dot} `}
        <span data-counter>{counter(0)}</span>
      </span>
    </h2>
    <div class="slides">
      {slides.map((slide, index) => (
        <div
          class="slide"
          data-slide
          data-counter-text={counter(index)}
          data-active={index === 0 ? '' : undefined}
        >
          <Testimonial
            quote={slide.quote}
            name={slide.name}
            role={slide.role}
            caseStudy={{ slug: slide.caseStudy }}
            markColor={slide.markColor}
            aria-roledescription={copy.slideRoleDescription}
            aria-label={slide.label}
          />
        </div>
      ))}
    </div>
    <div class="controls">
      <div class="dots" role="group" aria-label={copy.controlsLabel}>
        <span class="skewer" aria-hidden="true"></span>
        {slides.map((slide, index) => (
          <button
            class="dot"
            type="button"
            aria-label={slide.label}
            aria-current={index === 0 ? 'true' : undefined}
            data-dot
            style={`--dot-color: ${slide.dotColor}`}
          >
            <span class="dot-mark"></span>
          </button>
        ))}
      </div>
    </div>
    <p class="visually-hidden" aria-live="polite" aria-atomic="true" data-status></p>
  </gilda-testimonial-rotator>
</section>

<script>
  class GildaTestimonialRotator extends HTMLElement {
    private slides: HTMLElement[] = [];
    private dots: HTMLButtonElement[] = [];
    private index = 0;
    private gesture: { id: number; x: number; y: number } | null = null;
    private swiped = false;
    private events?: AbortController;

    connectedCallback() {
      this.events?.abort();
      this.events = new AbortController();
      const { signal } = this.events;
      this.slides = [...this.querySelectorAll<HTMLElement>('[data-slide]')];
      this.dots = [...this.querySelectorAll<HTMLButtonElement>('[data-dot]')];
      this.dots.forEach((dot, index) => {
        dot.addEventListener('click', () => this.show(index, true), { signal });
      });
      const slides = this.querySelector<HTMLElement>('.slides');
      slides?.addEventListener('pointerdown', this.onPointerDown, { signal });
      slides?.addEventListener('pointerup', this.onPointerUp, { signal });
      slides?.addEventListener('pointercancel', this.onPointerCancel, { signal });
      // A swipe that starts on the project link must not follow it on release.
      slides?.addEventListener('click', this.onClick, { capture: true, signal });
      this.show(this.index, false);
    }

    disconnectedCallback() {
      this.events?.abort();
      this.gesture = null;
    }

    private show(index: number, announce: boolean) {
      if (!this.slides.length) return;
      this.index = (index + this.slides.length) % this.slides.length;
      this.slides.forEach((slide, slideIndex) => {
        const active = slideIndex === this.index;
        slide.toggleAttribute('data-active', active);
        slide.inert = !active;
      });
      this.dots.forEach((dot, dotIndex) => {
        if (dotIndex === this.index) dot.setAttribute('aria-current', 'true');
        else dot.removeAttribute('aria-current');
      });
      const counter = this.querySelector('[data-counter]');
      if (counter) counter.textContent = this.slides[this.index]?.dataset.counterText ?? '';
      const status = this.querySelector('[data-status]');
      if (announce && status)
        status.textContent = this.dots[this.index]?.getAttribute('aria-label') ?? '';
    }

    private onPointerDown = (event: PointerEvent) => {
      this.swiped = false;
      if (!event.isPrimary) this.gesture = null;
      if (event.pointerType !== 'touch' || !event.isPrimary || this.slides.length < 2) return;
      this.gesture = { id: event.pointerId, x: event.clientX, y: event.clientY };
    };

    private onPointerUp = (event: PointerEvent) => {
      const gesture = this.gesture;
      this.gesture = null;
      if (!gesture || gesture.id !== event.pointerId) return;
      const dx = event.clientX - gesture.x;
      const dy = event.clientY - gesture.y;
      // Leave vertical scrolling, taps and small diagonal movements to the browser.
      if (Math.abs(dx) < 48 || Math.abs(dx) <= Math.abs(dy)) return;
      this.swiped = true;
      this.show(this.index + (dx < 0 ? 1 : -1), true);
    };

    private onPointerCancel = () => {
      this.gesture = null;
    };

    private onClick = (event: MouseEvent) => {
      if (!this.swiped || event.detail === 0) return;
      event.preventDefault();
      event.stopPropagation();
      this.swiped = false;
    };
  }

  if (!customElements.get('gilda-testimonial-rotator')) {
    customElements.define('gilda-testimonial-rotator', GildaTestimonialRotator);
  }
</script>

<style>
  .rotator {
    --rotator-gap: var(--space-9);
    --dot-size: 10px;
    --dot-size-active: 18px;
    --dot-target: var(--space-11);
    --dot-gap: 6px;
    --dot-duration: 150ms;

    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--rotator-gap);
    text-align: center;
  }

  .counter {
    color: var(--salt);
    font: var(--type-label);
    letter-spacing: var(--tracking-label);
  }

  /* Only the chosen quote contributes height; short quotes leave no empty slot. */
  .slides {
    inline-size: 100%;
    touch-action: pan-y pinch-zoom;
  }

  .slide:not([data-active]) {
    display: none;
  }

  .dots {
    position: relative;
    display: flex;
    align-items: center;
    gap: var(--dot-gap);
  }

  .skewer {
    position: absolute;
    inset-inline: calc(var(--dot-target) / 2);
    inset-block-start: 50%;
    block-size: 1px;
    background: color-mix(in srgb, var(--cream) 30%, transparent);
  }

  .dot {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    inline-size: var(--dot-target);
    block-size: var(--dot-target);
    padding: 0;
    border: 0;
    background: none;
    cursor: pointer;
  }

  .dot-mark {
    inline-size: var(--dot-size);
    block-size: var(--dot-size);
    border-radius: 50%;
    background: var(--dot-color);
    transition:
      inline-size var(--dot-duration) ease,
      block-size var(--dot-duration) ease;
  }

  .dot[aria-current='true'] .dot-mark {
    inline-size: var(--dot-size-active);
    block-size: var(--dot-size-active);
  }

  .visually-hidden {
    position: absolute;
    inline-size: 1px;
    block-size: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  /* Without JavaScript, every quote is listed and the controls are hidden. */
  @media (scripting: none) {
    .slides {
      display: grid;
      gap: var(--space-14);
    }

    .slide:not([data-active]) {
      display: block;
    }

    .counter-position,
    .controls {
      display: none;
    }
  }

  @media (width < 768px) {
    .rotator {
      --rotator-gap: var(--space-6);
      --dot-gap: 2px;

      align-items: flex-start;
      text-align: start;
    }

    .counter {
      font-size: var(--label-phone-size);
    }

    .controls {
      margin-inline-start: -14px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .dot-mark {
      transition: none;
    }
  }
</style>
