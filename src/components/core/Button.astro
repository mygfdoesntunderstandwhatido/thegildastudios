---
import type { HTMLAttributes } from 'astro/types';
import type { ButtonVariant, ControlSize } from './types';
import { CONTACT_PATH } from '../../lib/contact';

type CommonProps = {
  variant?: ButtonVariant;
  size?: ControlSize;
  disabled?: boolean;
  class?: string;
};
type Props = CommonProps &
  (
    | (Omit<HTMLAttributes<'a'>, 'class' | 'href' | 'type'> & { href: string })
    | (Omit<HTMLAttributes<'button'>, 'class' | 'disabled'> & { href?: never })
  );

const {
  variant = 'primary',
  size = 'md',
  disabled = false,
  href,
  class: className,
  ...attrs
} = Astro.props;
---

{href !== undefined ? (
  <a
    {...(attrs as HTMLAttributes<'a'>)}
    href={disabled ? undefined : href}
    role={disabled ? 'link' : attrs.role}
    aria-disabled={disabled || undefined}
    tabindex={disabled ? -1 : attrs.tabindex}
    class:list={['button', className]}
    data-variant={variant}
    data-size={size}
    data-analytics-cta={href.split('?')[0] === CONTACT_PATH ? '' : undefined}
  >
    <slot />
  </a>
) : (
  <button
    {...(attrs as HTMLAttributes<'button'>)}
    type={(attrs as HTMLAttributes<'button'>).type ?? 'button'}
    disabled={disabled}
    class:list={['button', className]}
    data-variant={variant}
    data-size={size}
  >
    <slot />
  </button>
)}

<style>
  .button {
    --button-size: 12px;
    --button-pad-block: 14px;
    --button-pad-inline: 22px;
    --button-background: var(--olive);
    --button-foreground: var(--cream);
    --button-ring: none;
    --button-disabled-opacity: 0.4;

    /* Hover sweeps this fill across the pill, left to right. By default it is
       a veil of the label colour, which keeps the label's contrast. */
    --button-sweep: color-mix(in srgb, var(--button-foreground) 14%, transparent);

    position: relative;
    isolation: isolate;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-2);
    max-inline-size: 100%;
    padding: var(--button-pad-block) var(--button-pad-inline);
    overflow: hidden;
    border: 0;
    border-radius: var(--radius-pill);
    background: var(--button-background);
    box-shadow: var(--button-ring);
    color: var(--button-foreground);
    font-family: var(--font-body);
    font-size: var(--button-size);
    font-weight: var(--weight-semibold);
    font-stretch: var(--stretch-button);
    line-height: 1;
    letter-spacing: var(--tracking-button);
    text-align: center;
    text-decoration: none;
    text-transform: uppercase;
    cursor: pointer;
    transition:
      opacity var(--hover-duration) ease,
      background-color var(--hover-duration) ease,
      transform var(--press-duration) var(--ease-settle);
  }

  /* The sweep sits between the fill and the label. It leaves to the right,
     the way it came in, so a pass over the button reads as one motion. */
  .button::before {
    position: absolute;
    z-index: -1;
    inset: 0;
    border-radius: inherit;
    background: var(--button-sweep);
    content: '';
    transform: scaleX(0);
    transform-origin: right center;
    transition: transform var(--sweep-duration) var(--ease-settle);
  }

  .button[data-size='sm'] {
    --button-size: 11px;
    --button-pad-block: 10px;
    --button-pad-inline: var(--space-4);
  }

  .button[data-variant='anchovy'] {
    --button-background: var(--anchovy);
  }

  .button[data-variant='dark'] {
    --button-background: var(--brine);
  }

  .button[data-variant='light'] {
    --button-background: var(--cream);
    --button-foreground: var(--brine);
  }

  .button[data-variant='outline'] {
    --button-background: transparent;
    --button-foreground: var(--brine);
    --button-ring: var(--ring-outline-button);
  }

  .button[data-variant='outline-light'] {
    --button-background: transparent;
    --button-ring: inset 0 0 0 1.5px var(--cream);
  }

  /* Olive and anchovy fills darken instead of fading: at 86% opacity their
     Cream labels fall under AA (3.7:1 and 4.3:1). The darker fill is also
     what sweeps in. */
  .button:is([data-variant='primary'], [data-variant='anchovy']) {
    --button-sweep: color-mix(in srgb, var(--button-background) 86%, var(--brine));
  }

  /* The sweep replaces the old fade, so a hovered label keeps full contrast. */
  .button:hover {
    background: var(--button-background);
    color: var(--button-foreground);
    opacity: 1;
  }

  .button:hover::before {
    transform: scaleX(1);
    transform-origin: left center;
  }

  /* A firm press: the pill gives a little under the pointer or key. */
  .button:active {
    transform: scale(var(--press-scale));
  }

  .button:is(:disabled, [aria-disabled='true']) {
    opacity: var(--button-disabled-opacity);
    cursor: default;
    transform: none;
  }

  .button:is(:disabled, [aria-disabled='true'])::before {
    display: none;
  }

  /* Touch screens keep :hover after a tap; skip the sweep there so a tapped
     button doesn't stay filled. The press still shows. */
  @media (hover: none) {
    .button:hover::before {
      transform: scaleX(0);
    }
  }

  @media (any-pointer: coarse) {
    .button {
      min-block-size: var(--space-11);
    }
  }

  /* Reduced motion: the sweep appears at once and the button never scales. */
  @media (prefers-reduced-motion: reduce) {
    .button,
    .button::before {
      transition-duration: 0s;
    }

    .button:active {
      transform: none;
    }
  }
</style>
