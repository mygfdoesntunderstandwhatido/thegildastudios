---
import { getEntry } from 'astro:content';
import Button from '../core/Button.astro';
import SiteHeader from '../layout/SiteHeader.astro';
import BranchStrip from './BranchStrip.astro';
import HeroMark from './HeroMark.astro';

const home = await getEntry('homepage', 'home');
const site = await getEntry('settings', 'site');
if (!home || !site) throw new Error('Missing the homepage or settings singleton in src/content');
const { hero } = home.data;
const { booking } = site.data;
---

<section class="band band--brine hero motion-enter" aria-labelledby="hero-title">
  <div class="hero-header">
    <SiteHeader skipTo="hero-copy" />
  </div>
  <div id="hero-copy" class="container hero-copy">
    <p class="eyebrow">
      <span class="wide">{hero.eyebrow}</span>
      <span class="short">{hero.eyebrowShort}</span>
    </p>
    <h1 id="hero-title" class="title">
      {hero.title}
    </h1>
    <p class="lede">{hero.body}</p>
    <div class="actions">
      <Button href={booking.href}>{booking.label}</Button>
      <Button variant="anchovy" href={hero.work.href}>
        <span class="wide">{hero.work.label}</span>
        <span class="short">{hero.work.labelShort}</span>
      </Button>
    </div>
  </div>
  <HeroMark class="hero-mark-place" alt={hero.markAlt} />
  <BranchStrip />
</section>

<style>
  .hero {
    --band-padding: 0;

    /* Between 768 and ~1150 the lede narrows and the mark shrinks so the two
       never overlap; from 1280 both are the artboard's 440px and 708px. */
    --hero-lede: min(440px, 52vw - var(--page-gutter) - var(--space-8));

    position: relative;
    display: flex;
    flex-direction: column;
    min-block-size: 820px;
    overflow: hidden;
  }

  .hero-header {
    position: relative;
    z-index: 2;
  }

  /* The copy floats over the mark; only its buttons take pointer input, so
     the pieces behind it can still be pointed at. */
  .hero-copy {
    position: relative;
    z-index: 1;
    display: flex;
    flex: 1;
    flex-direction: column;
    justify-content: center;
    gap: var(--space-7);
    max-inline-size: calc(600px + var(--page-gutter) * 2);
    margin-inline: 0;
    pointer-events: none;
  }

  .eyebrow {
    color: var(--pepper);
    font: var(--type-label);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
  }

  .title {
    font-family: var(--font-display);
    font-size: var(--display-124);
    font-weight: var(--weight-regular);
    line-height: var(--heading-leading);
  }

  .lede {
    max-inline-size: var(--hero-lede);
    color: var(--cream-2);
    font-size: 19px;
    line-height: 1.55;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    pointer-events: auto;
  }

  .short {
    display: none;
  }

  /* Desktop: the mark sits right of the copy, from 84px down, under the strip. */
  .hero-mark-place {
    position: absolute;
    inset-block-start: 84px;
    inset-inline-end: 10px;
    z-index: 0;
    inline-size: min(
      708px,
      55.3vw,
      100vw - 10px - var(--page-gutter) - var(--hero-lede) - var(--space-6)
    );
  }

  /* Entrance: the copy rises in through .motion-enter (src/styles/motion.css);
     the mark fades up behind it and the strip's three branches settle last,
     in branch order, over the strip's solid ground. The mark only fades, so
     its box never moves under the pointer. */
  @media (prefers-reduced-motion: no-preference) {
    .hero-mark-place {
      animation: gilda-fade-in calc(var(--enter-duration) * 1.4) var(--ease-settle) both;
      animation-delay: calc(var(--enter-stagger) * 2);
    }

    /* stylelint-disable-next-line selector-pseudo-class-no-unknown -- BranchStrip renders its own cells. */
    .hero :global(.strip-cell) {
      animation: gilda-enter var(--enter-duration) var(--ease-settle) both;
      animation-delay: calc(var(--enter-stagger) * (4 + var(--strip-step, 0)));
    }

    /* stylelint-disable-next-line selector-pseudo-class-no-unknown -- BranchStrip renders its own cells. */
    .hero :global(.strip-cell:nth-child(2)) {
      --strip-step: 1;
    }

    /* stylelint-disable-next-line selector-pseudo-class-no-unknown -- BranchStrip renders its own cells. */
    .hero :global(.strip-cell:nth-child(3)) {
      --strip-step: 2;
    }
  }

  @media (width < 768px) {
    .hero {
      min-block-size: 0;
    }

    .hero-copy {
      gap: 18px;
      padding-block: var(--space-8) var(--space-2);
    }

    .eyebrow {
      font-size: var(--label-phone-size);
    }

    .title {
      line-height: 1.04;
    }

    .lede {
      max-inline-size: 440px;
      font-size: 16px;
    }

    .actions {
      gap: 10px;
    }

    .wide {
      display: none;
    }

    .short {
      display: inline;
    }

    .hero-mark-place {
      position: relative;
      inset: auto;
      inline-size: 300px;
      margin: var(--space-6) auto 0;
    }
  }
</style>
