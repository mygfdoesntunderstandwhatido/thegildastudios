---
import type { CollectionEntry } from 'astro:content';
import Label from '../core/Label.astro';

interface Props {
  content: CollectionEntry<'systemPages'>['data'];
}

const { content } = Astro.props;
---

<main id="main" class="message band band--cream">
  <div class="container">
    <div class="copy">
      <Label>{content.eyebrow}</Label>
      <h1>{content.headline}</h1>
      <p>{content.body}</p>
      <nav aria-label={content.navLabel}>
        <ul>
          {content.links.map((link) => (
            <li>
              <a href={link.href}>{link.label}</a>
            </li>
          ))}
        </ul>
      </nav>
    </div>
  </div>
</main>

<style>
  .message {
    --band-padding: var(--band-space-spacious);
  }

  .copy {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-7);
  }

  h1 {
    max-inline-size: var(--preview-display-measure);
    font-size: var(--display-96);
  }

  p {
    max-inline-size: var(--body-measure);
    color: var(--ink-2);
    font: var(--type-body);
  }

  ul {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4) var(--space-7);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  a {
    display: inline-block;
    padding-block: var(--space-2);
    color: var(--brine);
    font-weight: var(--weight-semibold);
  }
</style>
