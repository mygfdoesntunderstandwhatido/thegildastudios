---
import { getEntry } from 'astro:content';
import Lockup from '../brand/Lockup.astro';

const settings = (await getEntry('settings', 'site'))!.data;
const { footer, email, phone } = settings;
const year = new Date().getUTCFullYear();
---

<footer class="site-footer band band--anchovy">
  <div class="container footer-inner">
    <nav class="footer-grid" aria-label={footer.navLabel}>
      <Lockup onDark />
      <div class="footer-column studio">
        <span class="column-label">{footer.studioLabel}</span>
        <ul>
          {footer.studioLinks.map((link) => (
            <li>
              <a href={link.href}>{link.label}</a>
            </li>
          ))}
        </ul>
      </div>
      <div class="footer-column projects">
        <span class="column-label">{footer.projectsLabel}</span>
        <ul>
          {footer.projectLinks.map((link) => (
            <li>
              <a href={link.href}>{link.label}</a>
            </li>
          ))}
        </ul>
      </div>
      <div class="footer-column contact">
        <span class="column-label">{footer.contactLabel}</span>
        <ul>
          <li>
            <a href={`mailto:${email}`}>{email}</a>
          </li>
          <li>
            <a href={phone.href}>{phone.label}</a>
          </li>
        </ul>
      </div>
    </nav>
    <p class="copyright">
      © {year} {footer.copyright}
    </p>
  </div>
</footer>

<style>
  .site-footer {
    --footer-link-size: 14px;
    --footer-link-gap: 10px;
    --footer-label-gap: 6px;
    --footer-phone-size: 15px;
    --band-padding: var(--space-12);

    padding-block-end: var(--space-8);
  }

  .footer-inner {
    display: grid;
    gap: var(--space-10);
  }

  /* Link columns never go narrower than their longest link, so the email
     address stays on one line on tablets. */
  .footer-grid {
    display: grid;
    grid-template-columns: minmax(0, 2fr) repeat(3, minmax(max-content, 1fr));
    gap: var(--space-8);
  }

  /* The artboard's link rows use normal leading, not the body's 1.6. */
  .footer-column {
    min-inline-size: 0;
    font-size: var(--footer-link-size);
    line-height: normal;
  }

  .column-label {
    display: block;
    margin-block-end: var(--space-4);
    color: var(--anchovy-label);
    font: var(--type-label-sm);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
  }

  ul {
    display: flex;
    flex-direction: column;
    gap: var(--footer-link-gap);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  a {
    color: inherit;
    text-decoration: none;
    overflow-wrap: anywhere;
  }

  /* Underline, not a fade: Cream on anchovy at 75% falls to 4.0:1. */
  a:hover {
    color: inherit;
    opacity: 1;
    text-decoration: underline;
    text-underline-offset: var(--link-underline-offset);
  }

  .copyright {
    padding-block-start: var(--space-5);
    border-block-start: var(--rule-row-width) solid var(--rule-dark-strong);
    color: var(--anchovy-label);
    font: var(--type-label-sm);
    letter-spacing: var(--tracking-label);
  }

  /* Phones keep every column and link, as on desktop: the lockup on top,
     Studio and Projects side by side, Contact below with the long email. */
  @media (width < 768px) {
    .site-footer {
      --band-padding: var(--space-10);
    }

    .footer-inner {
      gap: var(--space-8);
    }

    .footer-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: var(--space-8) var(--space-6);
    }

    /* stylelint-disable-next-line selector-pseudo-class-no-unknown -- The lockup is the Lockup component's root. */
    .footer-grid > :global(.lockup),
    .contact {
      grid-column: 1 / -1;
    }

    .footer-column {
      font-size: var(--footer-phone-size);
    }

    .copyright {
      padding-block-start: var(--space-4);
    }
  }
</style>
