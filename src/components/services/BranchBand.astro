---
import { Picture } from 'astro:assets';
import { branches, type BranchKey } from '../../lib/branches';
import { branchIllustrations } from '../../lib/branch-illustrations';

interface Props {
  branch: BranchKey;
  intro: string;
}

const { branch: key, intro } = Astro.props;
const branch = branches[key];
---

<section
  class="branch-band band"
  id={key}
  aria-labelledby={`${key}-title`}
  style={`--band-background: ${branch.color}; --branch-foreground: ${branch.foreground}`}
>
  <div class="container branch-grid">
    <div class="branch-copy">
      <p class="meta">
        {branch.number} / {branch.ingredient}
      </p>
      <h2 id={`${key}-title`}>{branch.name}</h2>
      <p class="intro">{intro}</p>
    </div>
    <div class="illustration" aria-hidden="true">
      <Picture
        src={branchIllustrations[key]}
        alt=""
        formats={['avif', 'webp']}
        fallbackFormat="png"
        widths={[96, 192, 280, 480]}
        sizes="(max-width: 767px) 60px, 200px"
        loading="lazy"
      />
    </div>
  </div>
</section>

<style>
  .branch-band {
    --band-padding: var(--band-space-compact);
    --branch-circle-size: 280px;
    --branch-image-width: 200px;
    --branch-image-height: 220px;
    --branch-intro-size: 19px;
    --branch-intro-measure: 600px;
    --branch-label-size: 12px;

    scroll-margin-block-start: var(--space-6);
    color: var(--branch-foreground);
  }

  .branch-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) var(--branch-circle-size);
    align-items: center;
    gap: var(--space-12);
  }

  .branch-copy {
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
  }

  .meta {
    font: var(--type-label);
    font-size: var(--branch-label-size);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
  }

  h2 {
    font-size: var(--display-120);
    line-height: var(--heading-leading-tight);
  }

  .intro {
    max-inline-size: var(--branch-intro-measure);
    font-size: var(--branch-intro-size);
    line-height: 1.55;
  }

  .illustration {
    display: flex;
    align-items: center;
    justify-content: center;
    inline-size: var(--branch-circle-size);
    block-size: var(--branch-circle-size);
    border-radius: 50%;
    background: var(--cream);
  }

  .illustration picture {
    display: flex;
    justify-content: center;
  }

  /* stylelint-disable-next-line selector-pseudo-class-no-unknown -- Astro's Picture owns the image. */
  .illustration :global(img) {
    inline-size: auto;
    max-inline-size: var(--branch-image-width);
    block-size: auto;
    max-block-size: var(--branch-image-height);
  }

  @media (width < 768px) {
    .branch-band {
      --band-padding: var(--space-10);
      --branch-circle-size: 88px;
      --branch-image-width: 60px;
      --branch-image-height: 66px;
      --branch-intro-size: 15px;
      --branch-label-size: 11px;
      --branch-phone-title: 64px;
      --branch-phone-gap: 14px;
    }

    .branch-grid {
      grid-template-columns: minmax(0, 1fr) var(--branch-circle-size);
      align-items: start;
      gap: var(--branch-phone-gap) var(--space-3);
    }

    .branch-copy {
      display: contents;
    }

    .meta,
    h2 {
      grid-column: 1;
    }

    h2 {
      font-size: var(--branch-phone-title);
    }

    .illustration {
      grid-column: 2;
      grid-row: 1 / 3;
    }

    .intro {
      grid-column: 1 / -1;
    }
  }
</style>
