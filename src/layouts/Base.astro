---
import '../styles/fonts.css';
import '../styles/tokens.css';
import '../styles/base.css';
import SiteHeader from '../components/layout/SiteHeader.astro';
import SiteFooter from '../components/layout/SiteFooter.astro';
import Analytics from '../components/analytics/Analytics.astro';
import Seo from '../components/seo/Seo.astro';
import { getSettings } from '../lib/settings';

interface Props {
  title?: string;
  description?: string;
  caseStudy?: { name: string };
  /** The site header's ground, or false when a page places it itself (the homepage hero). */
  header?: 'cream' | 'sand' | false;
}

const { title, description, caseStudy, header = 'cream' } = Astro.props;
const { seo } = await getSettings();
---

<!doctype html>
<html lang={seo.language}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <!-- Prioritise display and body type. Other faces load through CSS when used. -->
    <link
      rel="preload"
      href="/fonts/gilda-display-400.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/archivo-400-600.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <Seo title={title} description={description} caseStudy={caseStudy} />
    <Analytics />
  </head>
  <body>
    {header && <SiteHeader ground={header} />}
    <slot />
    <SiteFooter />
  </body>
</html>
