---
import '../styles/fonts.css';
import '../styles/tokens.css';
import '../styles/base.css';
import '../styles/motion.css';
import SiteHeader from '../components/layout/SiteHeader.astro';
import SiteFooter from '../components/layout/SiteFooter.astro';
import Analytics from '../components/analytics/Analytics.astro';
import Seo from '../components/seo/Seo.astro';
import { getSettings } from '../lib/settings';

interface Props {
  title?: string;
  description?: string;
  caseStudy?: { name: string };
  /** The site header's ground, or false when a page places it itself (the homepage hero). */
  header?: 'cream' | 'sand' | false;
}

const { title, description, caseStudy, header = 'cream' } = Astro.props;
const { seo } = await getSettings();

// Fetch a page's HTML while the pointer rests on its link (or on touch start),
// so the click lands on a page that is already downloaded. Prefetch never runs
// the page, so analytics only count real visits. Browsers without speculation
// rules ignore the tag. Worker routes and generated files are left alone.
const speculationRules = JSON.stringify({
  prefetch: [
    {
      where: {
        and: [
          { href_matches: '/*' },
          { not: { href_matches: ['/api/*', '/keystatic', '/keystatic/*', '/og/*', '/icons/*'] } },
          { not: { selector_matches: '[rel~=nofollow], [download], [target=_blank]' } },
        ],
      },
      eagerness: 'moderate',
    },
  ],
});
---

<!doctype html>
<html lang={seo.language}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <!-- Prioritise display and body type. Other faces load through CSS when used. -->
    <link
      rel="preload"
      href="/fonts/gilda-display-400.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/archivo-400-600.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <script type="speculationrules" is:inline set:html={speculationRules} />
    <Seo title={title} description={description} caseStudy={caseStudy} />
    <Analytics />
  </head>
  <body>
    {header && <SiteHeader ground={header} />}
    <slot />
    <SiteFooter />
  </body>
</html>
