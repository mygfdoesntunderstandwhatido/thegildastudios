---
import { getEntry } from 'astro:content';
import Base from '../layouts/Base.astro';
import AboutPage from '../components/about/AboutPage.astro';

const page = await getEntry('about', 'page');
if (!page) throw new Error('Missing src/content/about/page.json');
---

<Base title={page.data.meta.title} description={page.data.meta.description} header="sand">
  <AboutPage />
</Base>
