---
import type { GetStaticPaths } from 'astro';
import Base from '../../../layouts/Base.astro';
import CaseStudy from '../../../components/case-study/CaseStudy.astro';
import { getCaseStudies, nextCaseStudy, type CaseStudy as Entry } from '../../../lib/case-studies';

// Previews the template (#24) with the draft fixtures, which have no public page.
// Fixture quotes borrow real testimonials, so their back-link check is off here.
export const getStaticPaths = (async () => {
  const drafts = await getCaseStudies({ drafts: true });
  return drafts.map((entry, index) => ({
    params: { slug: entry.id },
    props: { entry, next: nextCaseStudy(drafts, index) },
  }));
}) satisfies GetStaticPaths;

interface Props {
  entry: Entry;
  next?: Entry;
}

const { entry, next } = Astro.props;
---

<Base title={entry.data.name} description={entry.data.short} header="sand">
  <main>
    <CaseStudy entry={entry} next={next} checkQuoteLinks={false} />
  </main>
</Base>
