---
import Base from '../../layouts/Base.astro';
import Label from '../../components/core/Label.astro';
import { labelPreview as content, previewGrounds } from '../../content/dev/primitives';
---

<Base title={content.title}>
  <main>
    <header class="band band--cream band--compact">
      <div class="container stack">
        <h1>{content.heading}</h1>
        <p>{content.intro}</p>
      </div>
    </header>
    {previewGrounds.map((ground) => (
      <section class:list={['band', ground.className]} aria-labelledby={`labels-${ground.id}`}>
        <div class="container stack">
          <h2 id={`labels-${ground.id}`}>{ground.label}</h2>
          {content.tones.map((tone) => (
            <section
              class:list={['stack', 'swatch', tone.onDark ? 'swatch-dark' : 'swatch-light']}
              aria-label={tone.label}
            >
              <Label as="h3" tone={tone.value}>
                {tone.label}
              </Label>
              <Label size="md" tone={tone.value}>
                {content.sample}
              </Label>
              <Label size="sm" tone={tone.value}>
                {content.sample}
              </Label>
              <Label tracking="running" tone={tone.value}>
                {content.running}
              </Label>
            </section>
          ))}
        </div>
      </section>
    ))}
  </main>
</Base>

<style>
  .stack {
    display: grid;
    gap: var(--space-6);
  }

  .swatch {
    padding: var(--space-6);
  }

  .swatch-dark {
    background: var(--brine);
    color: var(--cream);
  }

  .swatch-light {
    background: var(--cream);
    color: var(--brine);
  }
</style>
