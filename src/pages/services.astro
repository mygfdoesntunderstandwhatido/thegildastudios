---
import { getEntry } from 'astro:content';
import Base from '../layouts/Base.astro';
import ServicesPage from '../components/services/ServicesPage.astro';

const page = await getEntry('servicesPage', 'page');
if (!page) throw new Error('Missing src/content/services-page/page.json');
---

<Base title={page.data.meta.title} description={page.data.meta.description} header="sand">
  <ServicesPage />
</Base>
